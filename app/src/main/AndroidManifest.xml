<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Permissions for all versions (31+) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- For Android 13 (SDK 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />

    <!-- For Android 14 (SDK 34) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        android:minSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FindMyDevice"
        android:resizeableActivity="true"
        tools:ignore="UnusedAttribute">
        <activity
            android:name=".activity.FindMyDeviceActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:theme="@style/NoAnimationTheme">
        </activity>

        <provider
            android:name=".data.FindMyDeviceContentProvider"
            android:authorities="foundation.e.findmydevice.provider"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- Receivers -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".receiver.UiReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="foundation.e.findmydevice.NEW_PASSWORD" />
                <action android:name="foundation.e.findmydevice.CHECK_PASSWORD" />
                <action android:name="foundation.e.findmydevice.STATUS" />
            </intent-filter>
        </receiver>

        <service android:name=".location.LocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"/>

    </application>

</manifest>